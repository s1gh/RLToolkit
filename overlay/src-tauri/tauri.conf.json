{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rl-widget",
  "version": "0.2.0",
  "identifier": "io.rltoolkit.widget",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/rl-toolkit"],
    "category": "Utility",
    "shortDescription": "RL Toolkit launcher and overlay"
  }
}
