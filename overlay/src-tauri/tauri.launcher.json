{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RLT-Launcher",
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/rl-toolkit"],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./webview2-runtime/"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/s1gh/RLToolkit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMjc4Q0M5OUExM0QxQzIKUldUQzBST2F5WXduMm9Pc2lTbVdCekhSYUpLK3oxbTJrVHFSRUVpdDd1eHJ2dHBQb2tma2ZXdm4K"
    }
  }
}
