{
  "name": "dejavu",
  "title": "Déjà Vu",
  "version": "2.8.0",
  "author": "rl-toolkit",
  "description": "Tracks players you've encountered before and shows encounter history",
  "overlay": {
    "file": "overlay.html",
    "width": "auto",
    "height": "auto",
    "anchor": "bottom-left",
    "offset_x": 16,
    "offset_y": 16,
    "opacity": 0.9,
    "hide_when_unfocused": true,
    "show_during_phase": ["countdown", "live", "paused", "replay", "ended"]
  }
}
