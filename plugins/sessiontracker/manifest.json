{
  "name": "sessiontracker",
  "title": "Session Tracker",
  "version": "2.0.0",
  "author": "rl-toolkit",
  "description": "Tracks your current session's record, key stats, and MMR delta.",
  "overlay": {
    "file": "overlay.html",
    "width": 360,
    "height": 360,
    "anchor": "top-right",
    "offset_x": 16,
    "offset_y": 16,
    "opacity": 1.0,
    "hide_when_unfocused": true,
    "show_during_phase": ["lobby", "countdown", "live", "replay", "paused"]
  },
  "dashboard": { "file": "dashboard.html" },
  "settings": { "file": "settings.html" }
}
