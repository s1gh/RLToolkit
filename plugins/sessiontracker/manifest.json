{
  "name": "sessiontracker",
  "title": "Session Tracker",
  "version": "2.2.0",
  "author": "rl-toolkit",
  "description": "Tracks your current session's record, key stats, and MMR delta.",
  "overlay": {
    "file": "overlay.html",
    "width": 400,
    "height": 500,
    "anchor": "top-right",
    "offset_x": 16,
    "offset_y": 16,
    "opacity": 0.9,
    "hide_when_unfocused": true,
    "show_during_phase": ["countdown", "live", "replay", "paused"]
  },
  "dashboard": { "file": "dashboard.html" },
  "settings": { "file": "settings.html" }
}
