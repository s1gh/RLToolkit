{
  "name": "demos",
  "title": "Demolitions",
  "version": "1.0.0",
  "author": "rl-toolkit",
  "description": "Tracks how many players you've demolished, in this match and across all time",
  "overlay": {
    "file": "overlay.html",
    "width": 380,
    "height": 220,
    "anchor": "top-left",
    "offset_x": 12,
    "offset_y": 12,
    "opacity": 1,
    "click_through": true,
    "hide_when_unfocused": true,
    "show_during_phase": ["countdown", "live", "paused", "replay", "ended"]
  }
}
