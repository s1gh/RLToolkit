{
  "name": "demos",
  "title": "Demolitions",
  "version": "2.7.6",
  "author": "rl-toolkit",
  "description": "Tracks how many players you've demolished, in this match and across all time",
  "overlay": {
    "file": "overlay.html",
    "width": "auto",
    "height": "auto",
